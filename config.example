# swbr config  —  ~/.config/swbr/config
#
# The short one: each thing swbr can do, once, with nothing clever.
# config.advanced.example is the full version.
#
# key=value, '#' after a space starts a comment. Every key also works on the
# command line: swbr position=bottom height=32

# --- the bar itself ---------------------------------------------------------
position=top       # top | bottom
height=0           # 0 = from the text size
exclusive=0        # 0 = float over the windows, 1 = reserve the space
min_width=0        # 0 = the full width of the output
radius=10
# outputs=         # empty = every monitor

# --- colours ----------------------------------------------------------------
# Or set them once for swov and swas too, in ~/.config/sw/config
bg=0d1117e6
text=e1eeff
dim=5a6b7a
accent=89afc4
hl=cb9b00
urgent=e0533c

# --- workspaces -------------------------------------------------------------
ws_names=1         # 1 = names, 0 = numbers only
ws_other=1         # also the workspaces of your other monitors, as short pills
ws_cpu=1           # a column of dots: how busy each workspace is, in cores

# --- folding ----------------------------------------------------------------
hide_key=space     # hover the bar and press this to fold it to a thin strip
collapsed_px=5
slim_align=1       # folded, each mark keeps its cell's place and width

# --- a plain cell: a command, every few seconds ------------------------------
cell=clock
clock.cmd=date '+%H:%M  %a %d.%m'
clock.interval=5
clock.slim=clock       # folded: twelve bars, lit up to the hour
clock.hover_cal=1      # click it for this month, with today marked
clock.hover_click=1

# --- a cell swbr fills in itself --------------------------------------------
cell=battery
battery.source=battery # 83+ filling, 83- draining; reads /sys, spawns nothing
battery.interval=10
battery.slim=bar
battery.warn=<30:cecb00
battery.crit=<12:ff2222
battery.hover=%w  %h %e    # click it: 21.5W  1.7h left
battery.hover_click=1

# it can shout, too. Each level fires once on the way down and rearms when
# the charge comes back or the cable goes in
battery.alert=30,20,10,5
battery.alert_msg=BATTERY %c%%
battery.alert_tone=250     # Hz, 0 for silence. The last levels beep longer
battery.alert_play=aplay -q -f cd -
# battery.alert_cmd=[ %c -le 1 ] && poweroff

# --- music, if cmus is running ----------------------------------------------
cell=music
music.source=cmus      # runs cmus-remote itself; playing vs paused is a fact
music.slim=media
music.min_w=180

# --- a program and the workspaces it is on ----------------------------------
cell=mpv
mpv.source=window
mpv.program=mpv        # prints  mpv [3|5]
mpv.slim=presence

# --- where everything goes --------------------------------------------------
# || splits left / center / right, ',' separates, (a,b) glues two together.
# Keep this last.
bar={workspaces||music,mpv,clock,battery}
